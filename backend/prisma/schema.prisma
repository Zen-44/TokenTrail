// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Festival {
  id                Int        @id @default(autoincrement())
  festivalName      String
  organizerName     String
  email             String
  phone             String?
  location          String
  startDate         DateTime
  endDate           DateTime
  expectedAttendees String?
  sponsorBudget     String?
  description       String?
  website           String?
  wallet            String     @default("")
  approved          Boolean    @default(false)
  createdAt         DateTime   @default(now())

  // Token details
  tokenName         String?
  tokenSymbol       String?
  tokenSupply       BigInt?
  tokenAddress      String?    @unique

  // back-relations
  quests   Quest[]
  editors  FestivalEditor[]
  rewards  Reward[]
}

model Quest {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  reward      Int        // e.g. points or tokens
  difficulty  String?    // e.g. Easy, Medium, Hard
  duration    String?    // e.g. "2 hours"
  createdAt   DateTime   @default(now())
  startDate   DateTime
  endDate     DateTime

  festival    Festival   @relation(fields: [festivalId], references: [id])
  festivalId  Int

  steps       Step[]
  progress    QuestProgress[]
}

model Step {
  id        Int      @id @default(autoincrement())
  title     String
  order     Int
  createdAt DateTime @default(now())

  quest     Quest    @relation(fields: [questId], references: [id])
  questId   Int

  progress  StepProgress[]
}

model User {
  id          Int      @id @default(autoincrement())
  wallet      String   @unique // Phantom wallet address
  nonce       String?  // for authentication challenge
  isAdmin     Boolean  @default(false)
  createdAt   DateTime @default(now())

  questProgress QuestProgress[]
  stepProgress  StepProgress[]
  festivalsAsEditor FestivalEditor[]
  claims        RewardClaim[]
}

model QuestProgress {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int

  quest     Quest    @relation(fields: [questId], references: [id])
  questId   Int

  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([userId, questId])
}

model StepProgress {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int

  step      Step     @relation(fields: [stepId], references: [id])
  stepId    Int

  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([userId, stepId])
}

model FestivalEditor {
  id          Int      @id @default(autoincrement())
  festival    Festival @relation(fields: [festivalId], references: [id])
  festivalId  Int
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
  createdAt   DateTime @default(now())

  @@unique([festivalId, userId])
}

enum RewardCategory {
  Merchandise
  FoodAndDrinks
  Electronics
  Experiences
}

enum RewardTag {
  Limited
  Common
  Rare
  Premium
}

model Reward {
  id          Int            @id @default(autoincrement())
  title       String
  description String
  price       Int
  location    String
  stock       Int
  image       String
  category    RewardCategory
  tag         RewardTag

  festival    Festival       @relation(fields: [festivalId], references: [id])
  festivalId  Int

  claims      RewardClaim[]
}

enum RewardClaimStatus {
  PENDING
  PROCESSING
  PROCESSED
  DECLINED
}

model RewardClaim {
  id            Int               @id @default(autoincrement())
  nonce         String            @unique
  transaction   String?
  status        RewardClaimStatus @default(PENDING)
  claimCode     String?           @unique
  claimCodeUsed Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  reward        Reward            @relation(fields: [rewardId], references: [id])
  rewardId      Int

  user          User              @relation(fields: [userId], references: [id])
  userId        Int
}


