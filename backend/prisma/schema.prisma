generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Festival {
  id                Int        @id @default(autoincrement())
  festivalName      String
  organizerName     String
  email             String
  phone             String?
  location          String
  dates             String
  expectedAttendees String?
  sponsorBudget     String?
  description       String?
  website           String?
  createdAt         DateTime   @default(now())

  // back-relations
  token    Token?     @relation("FestivalToken")
  missions Mission[]  @relation("FestivalMissions")
}

model Token {
  id          Int      @id @default(autoincrement())
  festival    Festival @relation("FestivalToken", fields: [festivalId], references: [id])
  festivalId  Int      @unique
  mintAddress String   @unique
  symbol      String
  name        String
  decimals    Int      @default(9)
  supply      BigInt   @default(0)
}

model Mission {
  id           Int      @id @default(autoincrement())
  festival     Festival @relation("FestivalMissions", fields: [festivalId], references: [id])
  festivalId   Int
  title        String
  description  String?
  rewardAmount BigInt
  createdAt    DateTime @default(now())
}


